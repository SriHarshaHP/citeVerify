# CiteVerify Configuration
APP_NAME=CiteVerify
DEBUG=true
PORT=8000

# LLM Configuration (Provider agnostic: gemini | openai | anthropic | offline_mock)
LLM_PROVIDER=offline_mock
LLM_API_KEY=
LLM_MODEL_STRONG=gemini-1.5-pro
LLM_MODEL_FAST=gemini-1.5-flash

# Reliability & Offline Demo
OFFLINE_DEMO=true
CACHE_DIR=./.cache

# Scholarly APIs (Polite pool - no key required, provide contact email)
SCHOLARLY_CONTACT_EMAIL=citeverify-demo@innovedge2026.org
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Thresholds & Heuristics
TITLE_SIMILARITY_THRESHOLD=80.0
OUTDATED_YEARS_THRESHOLD=10
SCORE_REVIEW_THRESHOLD=0.50
ABSTRACT_SCORE_CAP=0.60
MAX_PDF_DOWNLOAD_BYTES=15728640
REQUEST_TIMEOUT_SECONDS=10
